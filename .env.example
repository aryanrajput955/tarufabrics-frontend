# Base URL of the clothEcom backend (Koa) API
NEXT_PUBLIC_API_URL=http://localhost:3010

# Public URL this storefront is deployed at (no trailing slash). Used for
# canonical links, sitemap.xml, robots.txt and Open Graph/JSON-LD image URLs —
# set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No PayFast key is needed here — the backend builds and signs the PayFast payment fields
# server-side (see backend/.env's PAYFAST_* vars) and returns them to the checkout page,
# which just POSTs a hidden form; there's no client-side PayFast SDK/key involved.
